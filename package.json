{
  "name": "icepac-browser",
  "version": "1.0.0",
  "description": "Icepac Browser",
  "main": "main.js",
  "author": "Ferdinand Barrack",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.icepac.browser",
    "productName": "ICEPAC BROWSER",
    "artifactName": "Icepac-Browser-Setup-${version}.exe",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
